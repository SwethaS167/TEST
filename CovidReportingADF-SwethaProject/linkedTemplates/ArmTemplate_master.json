{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "CovidReportingADF-SwethaProject"
		},
		"ls_ablob_covidreportingda_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_ablob_covidreportingda'"
		},
		"ls_ablob_covidreportingsto_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_ablob_covidreportingsto'"
		},
		"ls_formula1dl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_formula1dl'"
		},
		"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0703-140919-8l5t3qve"
		},
		"ls_ablob_covidreportingda_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://covidreportingda.dfs.core.windows.net/"
		},
		"ls_formula1dl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://formula1datalake01.dfs.core.windows.net/"
		},
		"ls_http_opendata_ecdc_europa_eu_fixed_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().sourcebaseURL}"
		},
		"trigger_databricks_properties_pipeline_parameters_p_file_date": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "CovidReportingADF-SwethaProject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_ablob_covidreportingda_accountKey": {
						"value": "[parameters('ls_ablob_covidreportingda_accountKey')]"
					},
					"ls_ablob_covidreportingsto_connectionString": {
						"value": "[parameters('ls_ablob_covidreportingsto_connectionString')]"
					},
					"ls_formula1dl_accountKey": {
						"value": "[parameters('ls_formula1dl_accountKey')]"
					},
					"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_ablob_covidreportingda_properties_typeProperties_url": {
						"value": "[parameters('ls_ablob_covidreportingda_properties_typeProperties_url')]"
					},
					"ls_formula1dl_properties_typeProperties_url": {
						"value": "[parameters('ls_formula1dl_properties_typeProperties_url')]"
					},
					"ls_http_opendata_ecdc_europa_eu_fixed_properties_typeProperties_url": {
						"value": "[parameters('ls_http_opendata_ecdc_europa_eu_fixed_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "CovidReportingADF-SwethaProject_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"trigger_databricks_properties_pipeline_parameters_p_file_date": {
						"value": "[parameters('trigger_databricks_properties_pipeline_parameters_p_file_date')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'CovidReportingADF-SwethaProject_ArmTemplate_0')]"
			]
		}
	]
}